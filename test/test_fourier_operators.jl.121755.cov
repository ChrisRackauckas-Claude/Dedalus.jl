        - """Tests for Fourier convert, differentiate, interpolate, integrate, average."""
        - 
        - using Test
        - using Dedalus
        - 
        1 @testset "Fourier Operators" begin
        - 
        2     N_range = [10]
        1     bounds_range = [(0.5, 1.666)]
        1     dealias_range = [1]
        2     dtype_range = [Float64, ComplexF64]
        - 
        2     @testset "convert constant N=$N bounds=$bounds dealias=$dealias T=$T layout=$layout" for
        -             N in N_range,
        -             bounds in bounds_range,
        -             dealias in dealias_range,
        -             T in dtype_range,
        -             layout in ["g", "c"]
        4         c = Coordinate("x")
        4         d = Distributor(c, dtype=T)
        0         b = Fourier(c, size=N, bounds=bounds, dealias=dealias, dtype=T)
        0         x = local_grid(d, b, scale=1)
        0         f = Field(d)
        0         f["g"] = 1
        0         change_layout!(f, layout)
        0         g = evaluate(Convert(f, b))
        0         @test isapprox(g["g"], f["g"], atol=1e-12)
        0     end
        - 
        2     @testset "differentiate N=$N bounds=$bounds dealias=$dealias T=$T" for
        -             N in N_range,
        -             bounds in bounds_range,
        -             dealias in dealias_range,
        -             T in dtype_range
        2         c = Coordinate("x")
        2         d = Distributor(c, dtype=T)
        0         b = Fourier(c, size=N, bounds=bounds, dealias=dealias, dtype=T)
        0         x = local_grid(d, b, scale=1)
        0         f = Field(d, bases=b)
        0         k = 4 * pi / (bounds[2] - bounds[1])
        0         f["g"] = @. 1 + sin(k * x + 0.1)
        0         g = evaluate(Differentiate(f, c))
        0         @test isapprox(g["g"], @.(k * cos(k * x + 0.1)), atol=1e-10)
        0     end
        - 
        2     @testset "interpolate N=$N bounds=$bounds dealias=$dealias T=$T" for
        -             N in N_range,
        -             bounds in bounds_range,
        -             dealias in dealias_range,
        -             T in dtype_range
        2         c = Coordinate("x")
        2         d = Distributor(c, dtype=T)
        0         b = Fourier(c, size=N, bounds=bounds, dealias=dealias, dtype=T)
        0         x = local_grid(d, b, scale=1)
        0         f = Field(d, bases=b)
        0         k = 4 * pi / (bounds[2] - bounds[1])
        0         f["g"] = @. 1 + sin(k * x + 0.1)
        0         for p in [bounds[1], bounds[2], bounds[1] + (bounds[2] - bounds[1]) * rand()]
        0             g = evaluate(Interpolate(f, c, p))
        0             @test isapprox(g["g"], 1 + sin(k * p + 0.1), atol=1e-10)
        0         end
        0     end
        - 
        2     @testset "integrate N=$N bounds=$bounds dealias=$dealias T=$T" for
        -             N in N_range,
        -             bounds in bounds_range,
        -             dealias in dealias_range,
        -             T in dtype_range
        2         c = Coordinate("x")
        2         d = Distributor(c, dtype=T)
        0         b = Fourier(c, size=N, bounds=bounds, dealias=dealias, dtype=T)
        0         x = local_grid(d, b, scale=1)
        0         f = Field(d, bases=b)
        0         k = 4 * pi / (bounds[2] - bounds[1])
        0         f["g"] = @. 1 + sin(k * x + 0.1)
        0         g = evaluate(Integrate(f, c))
        0         @test isapprox(g["g"], bounds[2] - bounds[1], atol=1e-10)
        0     end
        - 
        2     @testset "average N=$N bounds=$bounds dealias=$dealias T=$T" for
        -             N in N_range,
        -             bounds in bounds_range,
        -             dealias in dealias_range,
        -             T in dtype_range
        2         c = Coordinate("x")
        2         d = Distributor(c, dtype=T)
        0         b = Fourier(c, size=N, bounds=bounds, dealias=dealias, dtype=T)
        0         x = local_grid(d, b, scale=1)
        0         f = Field(d, bases=b)
        0         k = 4 * pi / (bounds[2] - bounds[1])
        0         f["g"] = @. 1 + sin(k * x + 0.1)
        0         g = evaluate(Average(f, c))
        0         @test isapprox(g["g"], 1, atol=1e-10)
        0     end
        - 
        - end
