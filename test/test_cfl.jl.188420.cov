        - """Tests for CFL timestep computation -- Cartesian only."""
        - 
        - using Test
        - using Dedalus
        - 
        1 @testset "CFL" begin
        - 
        3     @testset "full CFL Fourier-Chebyshev Nx=$Nx Nz=$Nz dealias=$dealias T=$T safety=$safety z_vel=$z_velocity_mag" for
        -             Nx in [32],
        -             Nz in [16],
        -             dealias in [1, 1.5],
        -             T in [Float64, ComplexF64],
        -             safety in [0.2, 0.4],
        -             z_velocity_mag in [0, 2]
       16         Lx = 2.0
       16         Lz = 1.0
       16         c = CartesianCoordinates("x", "z")
       16         d = Distributor(c, dtype=T)
        0         xb = Fourier(c.coords[1], size=Nx, bounds=(0, Lx), dealias=dealias, dtype=T)
        0         zb = Chebyshev(c.coords[2], size=Nz, bounds=(0, Lz), dealias=dealias)
        0         x, z = local_grids(d, xb, zb)
        -         # IVP
        0         u = VectorField(d, c, bases=(xb, zb))
        0         problem = IVP([u], namespace=Dict("u" => u, "dt" => dt))
        0         add_equation!(problem, "dt(u) = 0")
        0         solver = build_solver(problem, SBDF1)
        -         # CFL
        0         cfl = CFL(solver, initial_dt=1, safety=safety, cadence=1)
        0         add_velocity!(cfl, u)
        -         # Test
        0         fill_random!(u, layout="g")
        0         for i in 1:2
        0             step!(solver, 1)
        0         end
        0         dt_cfl = compute_timestep(cfl)
        0         cfl_op = AdvectiveCFL(u, c)
        0         spacing = cfl_spacing(cfl_op)
        0         cfl_freq = abs.(u["g"][1, :, :]) ./ spacing[1]
        0         cfl_freq .+= abs.(u["g"][2, :, :]) ./ spacing[2]
        0         cfl_freq_max = maximum(cfl_freq)
        0         dt_target = safety / cfl_freq_max
        0         @test isapprox(dt_cfl, dt_target, atol=1e-12)
        0     end
        - 
        2     @testset "CFL Fourier N=$N L=$L dealias=$dealias T=$T" for
        -             N in [32],
        -             L in [1.44],
        -             dealias in [1, 1.5],
        -             T in [Float64, ComplexF64]
        4         c = CartesianCoordinates("x")
        4         d = Distributor(c, dtype=T)
        0         b = Fourier(c.coords[1], size=N, bounds=(0, L), dealias=dealias, dtype=T)
        0         x = local_grid(d, b, scale=1)
        0         u = VectorField(d, c, bases=b)
        0         fill_random!(u, layout="g")
        0         cfl = AdvectiveCFL(u, c)
        0         cfl_freq = evaluate(cfl)["g"]
        0         target_freq = abs.(u["g"]) ./ cfl_spacing(cfl)[1]
        0         @test isapprox(cfl_freq, target_freq, atol=1e-12)
        0     end
        - 
        2     @testset "CFL Chebyshev N=$N L=$L dealias=$dealias T=$T" for
        -             N in [32],
        -             L in [1.44],
        -             dealias in [1, 1.5],
        -             T in [Float64, ComplexF64]
        4         c = CartesianCoordinates("x")
        4         d = Distributor(c, dtype=T)
        0         b = Chebyshev(c.coords[1], size=N, bounds=(0, L), dealias=dealias)
        0         x = local_grid(d, b, scale=1)
        0         u = VectorField(d, c, bases=b)
        0         fill_random!(u, layout="g")
        0         cfl = AdvectiveCFL(u, c)
        0         cfl_freq = evaluate(cfl)["g"]
        0         target_freq = abs.(u["g"]) ./ cfl_spacing(cfl)[1]
        0         @test isapprox(cfl_freq, target_freq, atol=1e-12)
        0     end
        - 
        2     @testset "CFL Fourier-Chebyshev Nx=$Nx Nz=$Nz dealias=$dealias T=$T z_vel=$z_velocity_mag" for
        -             Nx in [32],
        -             Nz in [16],
        -             dealias in [1, 1.5],
        -             T in [Float64, ComplexF64],
        -             z_velocity_mag in [0, 2]
        8         c = CartesianCoordinates("x", "z")
        8         d = Distributor(c, dtype=T)
        0         xb = Fourier(c.coords[1], size=Nx, bounds=(0, 2), dealias=dealias, dtype=T)
        0         zb = Chebyshev(c.coords[2], size=Nz, bounds=(0, 1), dealias=dealias)
        0         x, z = local_grids(d, xb, zb)
        0         u = VectorField(d, c, bases=(xb, zb))
        0         fill_random!(u, layout="g")
        0         cfl = AdvectiveCFL(u, c)
        0         cfl_freq = evaluate(cfl)["g"]
        0         spacing = cfl_spacing(cfl)
        0         target_freq = abs.(u["g"][1, :, :]) ./ spacing[1]
        0         target_freq .+= abs.(u["g"][2, :, :]) ./ spacing[2]
        0         @test isapprox(cfl_freq, target_freq, atol=1e-12)
        0     end
        - 
        - end
