        - """Tests for Jacobi convert, differentiate, interpolate, integrate, average, lift."""
        - 
        - using Test
        - using Dedalus
        - 
        1 @testset "Jacobi Operators" begin
        - 
        3     N_range = [8, 9]
        2     ab_range = [(-0.5, -0.5), (0.0, 0.0)]
        2     k_range = [0, 1]
        1     dealias_range = [1]
        2     dtype_range = [Float64, ComplexF64]
        - 
        2     @testset "convert constant N=$N (a,b)=$ab k=$k dealias=$dealias T=$T layout=$layout" for
        -             N in N_range,
        -             ab in ab_range,
        -             k in k_range,
        -             dealias in dealias_range,
        -             T in dtype_range,
        -             layout in ["g", "c"]
       32         a, b = ab
       32         c = Coordinate("x")
       32         d = Distributor(c, dtype=T)
        0         basis = Jacobi(c, size=N, a0=a, b0=b, a=a + k, b=b + k, bounds=(0, 1), dealias=dealias)
        0         x = local_grid(d, basis, scale=1)
        0         f = Field(d)
        0         f["g"] = 1
        0         change_layout!(f, layout)
        0         g = evaluate(Convert(f, basis))
        0         @test isapprox(g["g"], f["g"], atol=1e-12)
        0     end
        - 
        2     @testset "convert N=$N (a,b)=$ab k=$k dk=$dk dealias=$dealias T=$T layout=$layout" for
        -             N in N_range,
        -             ab in ab_range,
        -             k in k_range,
        -             dk in [0, 1, 2],
        -             dealias in dealias_range,
        -             T in dtype_range,
        -             layout in ["g", "c"]
       96         a, b = ab
       96         c = Coordinate("x")
       96         d = Distributor(c, dtype=T)
        0         basis = Jacobi(c, size=N, a0=a, b0=b, a=a + k, b=b + k, bounds=(0, 1), dealias=dealias)
        0         x = local_grid(d, basis, scale=1)
        0         f = Field(d, bases=basis)
        0         fill_random!(f, layout="g")
        0         low_pass_filter!(f, scales=0.5)
        0         change_layout!(f, layout)
        0         g = evaluate(Convert(f, derivative_basis(basis, dk)))
        0         @test isapprox(g["g"], f["g"], atol=1e-10)
        0     end
        - 
        2     @testset "convert implicit N=$N (a,b)=$ab k=$k dk=$dk dealias=$dealias T=$T" for
        -             N in N_range,
        -             ab in ab_range,
        -             k in k_range,
        -             dk in [0, 1, 2],
        -             dealias in dealias_range,
        -             T in dtype_range
       48         a, b = ab
       48         c = Coordinate("x")
       48         d = Distributor(c, dtype=T)
        0         basis = Jacobi(c, size=N, a0=a, b0=b, a=a + k, b=b + k, bounds=(0, 1), dealias=dealias)
        0         x = local_grid(d, basis, scale=1)
        0         f = Field(d, bases=derivative_basis(basis, dk))
        0         fill_random!(f, layout="g")
        0         low_pass_filter!(f, scales=0.5)
        0         g = Field(d, bases=basis)
        0         problem = LBVP([g], namespace=Dict("g" => g, "f" => f))
        0         add_equation!(problem, "g = f")
        0         solver = build_solver(problem)
        0         solve!(solver)
        0         @test isapprox(g["g"], f["g"], atol=1e-10)
        0     end
        - 
        2     @testset "differentiate N=$N (a,b)=$ab k=$k dealias=$dealias T=$T" for
        -             N in N_range,
        -             ab in ab_range,
        -             k in k_range,
        -             dealias in dealias_range,
        -             T in dtype_range
       16         a, b = ab
       16         c = Coordinate("x")
       16         d = Distributor(c, dtype=T)
        0         basis = Jacobi(c, size=N, a0=a, b0=b, a=a + k, b=b + k, bounds=(0, 1), dealias=dealias)
        0         x = local_grid(d, basis, scale=1)
        0         f = Field(d, bases=basis)
        0         f["g"] = @. x^5
        0         g = evaluate(Differentiate(f, c))
        0         @test isapprox(g["g"], @.(5 * x^4), atol=1e-10)
        0     end
        - 
        2     @testset "interpolate N=$N (a,b)=$ab k=$k dealias=$dealias T=$T" for
        -             N in N_range,
        -             ab in ab_range,
        -             k in k_range,
        -             dealias in dealias_range,
        -             T in dtype_range
       16         a, b = ab
       16         c = Coordinate("x")
       16         d = Distributor(c, dtype=T)
        0         basis = Jacobi(c, size=N, a0=a, b0=b, a=a + k, b=b + k, bounds=(0, 1), dealias=dealias)
        0         x = local_grid(d, basis, scale=1)
        0         f = Field(d, bases=basis)
        0         f["g"] = @. x^5
        0         for p in [0.0, 1.0, rand()]
        0             fp = evaluate(Interpolate(f, c, p))
        0             @test isapprox(fp["g"], p^5, atol=1e-10)
        0         end
        0     end
        - 
        2     @testset "integrate N=$N (a,b)=$ab k=$k dealias=$dealias T=$T" for
        -             N in N_range,
        -             ab in ab_range,
        -             k in k_range,
        -             dealias in dealias_range,
        -             T in dtype_range
       16         a, b = ab
       16         c = Coordinate("x")
       16         d = Distributor(c, dtype=T)
        0         basis = Jacobi(c, size=N, a0=a, b0=b, a=a + k, b=b + k, bounds=(0, 3), dealias=dealias)
        0         x = local_grid(d, basis, scale=1)
        0         f = Field(d, bases=basis)
        0         f["g"] = @. 6 * x^5
        0         g = evaluate(Integrate(f, c))
        0         @test isapprox(g["g"], 3^6, atol=1e-8)
        0     end
        - 
        2     @testset "average N=$N (a,b)=$ab k=$k dealias=$dealias T=$T" for
        -             N in N_range,
        -             ab in ab_range,
        -             k in k_range,
        -             dealias in dealias_range,
        -             T in dtype_range
       16         a, b = ab
       16         c = Coordinate("x")
       16         d = Distributor(c, dtype=T)
        0         basis = Jacobi(c, size=N, a0=a, b0=b, a=a + k, b=b + k, bounds=(0, 3), dealias=dealias)
        0         x = local_grid(d, basis, scale=1)
        0         f = Field(d, bases=basis)
        0         f["g"] = @. 6 * x^5
        0         g = evaluate(Average(f, c))
        0         @test isapprox(g["g"], 3^6 / 3, atol=1e-8)
        0     end
        - 
        2     @testset "lift N=$N (a,b)=$ab k=$k n=$n dealias=$dealias T=$T" for
        -             N in N_range,
        -             ab in ab_range,
        -             k in k_range,
        -             n in [-1, -2],
        -             dealias in dealias_range,
        -             T in dtype_range
       32         a, b = ab
       32         c = Coordinate("x")
       32         d = Distributor(c, dtype=T)
        0         basis = Jacobi(c, size=N, a0=a, b0=b, a=a + k, b=b + k, bounds=(0, 3), dealias=dealias)
        0         x = local_grid(d, basis, scale=1)
        0         lift_basis = derivative_basis(basis, k)
        0         f = Field(d, bases=lift_basis)
        0         f["c"][end + n + 1] = 2  # Julia 1-based indexing for negative index
        0         tau = Field(d)
        0         tau["g"] = 2
        0         g = evaluate(Lift(tau, lift_basis, n))
        0         @test isapprox(g["g"], f["g"], atol=1e-12)
        0     end
        - 
        - end
